# ── Application ──────────────────────────────────────────────────
APP_NAME=Physio Wellness Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated origins) ──────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/physio_wellness

# ── Security & JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

