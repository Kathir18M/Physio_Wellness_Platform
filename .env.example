# ==============================================================================
# PHYSIO WELLNESS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDER VALUES BEFORE RUNNING.
# NEVER COMMIT ACTUAL SECRET KEYS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ── Application Environment ────────────────────────────────────────────────────
APP_NAME="Physio Wellness Platform"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=production # development | staging | production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://physiowellness.com", "http://localhost:3000"]

# ── Database & Cache ─────────────────────────────────────────────────────────
# PostgreSQL Connection URL
DATABASE_URL=postgresql+asyncpg://physio_user:YOUR_POSTGRES_PASSWORD_HERE@postgres:5432/physio_wellness
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Background Queue URL
REDIS_URL=redis://redis:6379/0

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate a strong 256-bit secret key in production: `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256BIT_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_ISSUER=physio-wellness-auth

# ── Payment Provider Configuration ───────────────────────────────────────────
PAYMENT_PROVIDER=mock # mock | stripe | razorpay
PAYMENT_SECRET_KEY=sk_live_YOUR_PAYMENT_PROVIDER_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=whsec_YOUR_PAYMENT_WEBHOOK_SIGNING_SECRET

# ── AI Integration Configuration ──────────────────────────────────────────────
AI_PROVIDER=mock # mock | gemini | openai
AI_API_KEY=YOUR_GEMINI_OR_OPENAI_API_KEY_HERE
AI_MODEL_NAME=gemini-2.5-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=3

# ── Notifications & Email Services ────────────────────────────────────────────
EMAIL_PROVIDER=mock # mock | smtp | sendgrid
WHATSAPP_PROVIDER=mock # mock | twilio | meta
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY_OR_PASSWORD
WHATSAPP_API_KEY=YOUR_WHATSAPP_GATEWAY_API_KEY

# ── Frontend API Gateway Configuration ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://physiowellness.com/api/v1
